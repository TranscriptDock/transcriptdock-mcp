{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.transcriptdock/mcp",
  "description": "YouTube and TikTok transcripts: get_video_transcript in one call, jobs, exports, video discovery.",
  "version": "0.1.3",
  "websiteUrl": "https://www.transcriptdock.com/docs/mcp",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@transcriptdock/mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TRANSCRIPTDOCK_API_KEY",
          "description": "Workspace API key (td_live_...)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "TRANSCRIPTDOCK_BASE_URL",
          "description": "API origin, https://www.transcriptdock.com",
          "default": "https://www.transcriptdock.com",
          "isRequired": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.transcriptdock.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional: Bearer td_live_... workspace API key. Without it, clients sign in with OAuth.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
